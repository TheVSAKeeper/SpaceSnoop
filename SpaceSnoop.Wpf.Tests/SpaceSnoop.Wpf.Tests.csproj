<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(UseNet11)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(UseNet11)' == 'true'">net11.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Опоры тестов каркаса: сток ошибок биндинга, STA-хост окна, MemorySettings, правила разметки. -->
    <PackageReference Include="KeepShell.Testing" Version="0.1.272" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="KeepShell.Agents" />
    <Using Include="SpaceSnoop.Wpf.Agent.IAgentTranscript" Alias="IAgentTranscript" />
    <Using Include="SpaceSnoop.Wpf.Agent.AgentTranscriptKind" Alias="AgentTranscriptKind" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SpaceSnoop.Tests\TestAcl.cs" Link="TestAcl.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpaceSnoop.Core\SpaceSnoop.Core.csproj" />
    <ProjectReference Include="..\SpaceSnoop.Wpf\SpaceSnoop.Wpf.csproj" />
  </ItemGroup>

</Project>
