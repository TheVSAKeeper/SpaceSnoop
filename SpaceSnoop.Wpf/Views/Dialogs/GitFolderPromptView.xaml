<UserControl x:Class="SpaceSnoop.Wpf.Views.Dialogs.GitFolderPromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Dialogs"
             xmlns:views="clr-namespace:SpaceSnoop.Wpf.Views"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GitFolderPromptViewModel}"
             d:DesignHeight="280"
             d:DesignWidth="620"
             Width="{DynamicResource Dialog.Width.Medium}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.GitBranch}"
                                      Width="20"
                                      Height="20"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      Foreground="{DynamicResource Accent.Text}" />
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource DialogTitle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,14,0,0">
            <TextBlock Text="{Binding CountText}"
                       Foreground="{DynamicResource Fg.Primary}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0"
                       Text="Их можно синхронизировать, но это множество мелких служебных файлов, которые в резервной копии обычно не нужны."
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,0"
                       Text="Пропустить .git и копировать только рабочие файлы?"
                       Foreground="{DynamicResource Fg.Primary}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <views:FirstFitPanel Grid.Row="2"
                             Margin="0,22,0,0">
            <views:FirstFitPanel.Resources>
                <Style x:Key="Git.Keep"
                       TargetType="Button"
                       BasedOn="{StaticResource Button.Secondary}">
                    <Setter Property="Command"
                            Value="{Binding KeepCommand}" />
                    <Setter Property="Content"
                            Value="Синхронизировать .git" />
                    <Setter Property="MinWidth"
                            Value="96" />
                    <Setter Property="MinHeight"
                            Value="{DynamicResource Control.Height.Default}" />
                    <Setter Property="Padding"
                            Value="14,6" />
                    <Setter Property="IsCancel"
                            Value="{Binding IsVisible, RelativeSource={RelativeSource Self}}" />
                </Style>
                <Style x:Key="Git.Skip"
                       TargetType="Button"
                       BasedOn="{StaticResource Button.Primary}">
                    <Setter Property="Command"
                            Value="{Binding SkipCommand}" />
                    <Setter Property="Content"
                            Value="Пропустить .git" />
                    <Setter Property="MinWidth"
                            Value="96" />
                    <Setter Property="MinHeight"
                            Value="{DynamicResource Control.Height.Default}" />
                    <Setter Property="Padding"
                            Value="14,6" />
                    <Setter Property="IsDefault"
                            Value="{Binding IsVisible, RelativeSource={RelativeSource Self}}" />
                </Style>
            </views:FirstFitPanel.Resources>

            <Grid x:Name="ChoiceRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Content="Больше не спрашивать"
                          IsChecked="{Binding RememberChoice}"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource Git.Keep}"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource Git.Skip}" />
                </StackPanel>
            </Grid>

            <DockPanel x:Name="ChoiceColumn"
                       LastChildFill="False">
                <CheckBox DockPanel.Dock="Top"
                          Content="Больше не спрашивать"
                          IsChecked="{Binding RememberChoice}"
                          Margin="0,0,0,6" />
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource Git.Keep}"
                        Margin="0,8,0,0" />
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource Git.Skip}"
                        Margin="0,8,0,0" />
            </DockPanel>
        </views:FirstFitPanel>
    </Grid>
</UserControl>
