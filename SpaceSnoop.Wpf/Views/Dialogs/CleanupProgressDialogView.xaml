<UserControl x:Class="SpaceSnoop.Wpf.Views.Dialogs.CleanupProgressDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Dialogs"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:behaviors="clr-namespace:SpaceSnoop.Wpf.Views.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CleanupProgressDialogViewModel}"
             d:DesignHeight="300"
             d:DesignWidth="640"
             Width="{DynamicResource Dialog.Width.Medium}"
             MinHeight="200"
             AutomationProperties.Name="{Binding Title}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                      Width="20"
                                      Height="20"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      Foreground="{DynamicResource Accent.Text}" />
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource DialogTitle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer x:Name="Body"
                      Grid.Row="1"
                      Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <Border Style="{StaticResource Card.Inset}"
                            Padding="14"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconLucide Grid.Column="0"
                                                          Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,9,0"
                                                          Foreground="{DynamicResource Fg.Muted}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TargetName}"
                                           AutomationProperties.Name="Что очищается"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Fg.Primary}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding PlanText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           FontSize="{DynamicResource Font.Size.S}"
                                           Foreground="{DynamicResource Fg.Muted}" />
                            </Grid>

                            <TextBlock Text="{Binding FateText}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource TextBlock.Subtle}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource TextBlock.Subtle}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ResultHeading}"
                                   FontSize="{DynamicResource Font.Size.L}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Border Style="{StaticResource Card.Inset}"
                                Padding="14"
                                Margin="0,14,0,0">
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Освобождено"
                                               Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding FreedText}"
                                               AutomationProperties.Name="Освобождено"
                                               FontSize="{DynamicResource Font.Size.XL}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Accent.Text}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="8,0">
                                    <TextBlock Text="Удалено"
                                               Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding DeletedText}"
                                               AutomationProperties.Name="Удалено файлов"
                                               FontSize="{DynamicResource Font.Size.XL}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Fg.Primary}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Пропущено"
                                               Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding SkippedText}"
                                               AutomationProperties.Name="Пропущено файлов"
                                               FontSize="{DynamicResource Font.Size.XL}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSkipped}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource State.WarningText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="Корзину Windows отмена не остановила: этот шаг не прерывается."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding ShowIndivisibleResult, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Minimum="0"
                                     Maximum="1"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     AutomationProperties.Name="Ход очистки"
                                     Value="{Binding ProgressValue, Mode=OneWay}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountText}"
                                   AutomationProperties.Name="Удалено"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Accent.Text}" />
                    </Grid>

                    <TextBlock behaviors:PathTrimmer.FullPath="{Binding CurrentPath}"
                               AutomationProperties.Name="Текущий файл"
                               Margin="0,8,0,0"
                               TextWrapping="NoWrap"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Font.Size.S}"
                               Foreground="{DynamicResource Fg.Muted}"
                               ToolTip="{Binding CurrentPath}"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

                    <TextBlock Text="{Binding IndivisibleText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource TextBlock.Subtle}"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding IsStepIndivisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                </StackPanel>

                <Expander Header="Что осталось"
                          IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}"
                          Style="{DynamicResource Expander.Section}"
                          Margin="0,12,0,0"
                          Visibility="{Binding HasErrorDetails, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorDetailsCaption}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource TextBlock.Subtle}" />
                        <ItemsControl ItemsSource="{Binding Issues}"
                                      Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CleanupIssue}">
                                    <Border Style="{DynamicResource Card.Inset}"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Fg.Primary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Reason}"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       Foreground="{DynamicResource Fg.Secondary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <Expander Header="Путь и подробности"
                                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      Style="{DynamicResource Expander.Section}"
                                                      Margin="-6,4,0,0">
                                                <TextBlock Text="{Binding Details}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource Font.Size.S}"
                                                           Foreground="{DynamicResource Fg.Secondary}" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Устраните причины и повторите замер перед новой попыткой."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>
                <Expander Header="Сведения об ошибке"
                          IsExpanded="{Binding IsFailureExpanded, Mode=TwoWay}"
                          Style="{DynamicResource Expander.Section}"
                          Margin="0,12,0,0"
                          Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding FailureText}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource Font.Size.S}"
                               Foreground="{DynamicResource Fg.Secondary}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding CloseCommand}"
                        Content="Отмена"
                        MinWidth="96"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Style="{StaticResource Button.Destructive}"
                        Command="{Binding StartCommand}"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="16,6"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ActionText}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding CancelRunCommand}"
                        IsEnabled="{Binding CanCancelStep}"
                        Content="Остановить"
                        MinWidth="96"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="14,6" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding CloseCommand}"
                        Content="Закрыть"
                        MinWidth="96"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="16,6"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
