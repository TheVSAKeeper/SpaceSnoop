<UserControl x:Class="SpaceSnoop.Wpf.Views.Cleanup.ProjectCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Cleanup"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Проекты .NET" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="Выберите каталог с проектами. Поиск найдёт bin/obj и отдельные результаты тестов и бенчмарков."
                               TextWrapping="Wrap" Style="{StaticResource TextBlock.Subtle}" Margin="0,0,0,12" />
                    <TextBox x:Name="ProjectRoot" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Каталог проектов"
                             ToolTip="Поиск ограничен этим каталогом. Ссылки и нестандартные пути сборки не обходятся." />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Выбрать каталог…" Style="{StaticResource Button.Secondary}"
                                Command="{Binding BrowseCommand}" Padding="12,6" Margin="0,0,10,6" />
                        <Button Content="Найти артефакты" Style="{StaticResource Button.Base}"
                                Command="{Binding FindCommand}" Padding="12,6" Margin="0,0,10,6" />
                        <Button Content="Отменить" Style="{StaticResource Button.Ghost}"
                                Command="{Binding CancelCommand}" Padding="10,6" Margin="0,0,0,6"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="Перед очисткой остановите сборки, тесты и бенчмарки. В bin/obj могут лежать ваши файлы; проверьте их перед выбором."
                               TextWrapping="Wrap" Foreground="{DynamicResource State.WarningText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,10"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Результат очистки проектов" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Primary}" />
                    <TextBlock Text="Файлы остаются в корзине и продолжают занимать место на диске."
                               TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                    Visibility="{Binding HasArtifacts, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,28,8">
                            <TextBlock Text="Найдено" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TotalText}" Style="{StaticResource StatValue}" FontSize="{DynamicResource Font.Size.L}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,8">
                            <TextBlock Text="Выбрано" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SelectedText}" Style="{StaticResource StatValue}"
                                       FontSize="{DynamicResource Font.Size.L}" Foreground="{DynamicResource Accent.Text}" />
                            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <Button Content="Отправить выбранное в корзину" Style="{StaticResource Button.Base}"
                                    Command="{Binding CleanCommand}" HorizontalAlignment="Left" Padding="12,6" />
                            <Button Content="Снять выбор" Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ClearSelectionCommand}" HorizontalAlignment="Left" Padding="10,4" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Все каталоги выбираются вручную. Новые и изменившиеся файлы, а также пустые каталоги останутся."
                               TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="ProjectArtifacts" ItemsSource="{Binding Artifacts}" IsEnabled="{Binding IsIdle}"
                                  Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectArtifactViewModel}">
                                <Border Padding="0,12" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ProjectNumbers" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                                  VerticalAlignment="Top" Margin="0,4,12,0" AutomationProperties.Name="{Binding Path}" />
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Primary}" />
                                            <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                     Padding="0" Background="Transparent" MinHeight="0" Margin="0,4,0,0"
                                                     AutomationProperties.Name="Путь проектных артефактов" />
                                            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                            <Button Content="Открыть каталог" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Padding="6,4" Margin="-6,2,0,0" />
                                            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource State.WarningText}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource TextBlock.Mono}" TextAlignment="Right" />
                                            <TextBlock Text="{Binding FilesText}" Style="{StaticResource Caption}" TextAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Style="{StaticResource TextBlock.Subtle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
