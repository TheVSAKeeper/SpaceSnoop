<UserControl x:Class="SpaceSnoop.Wpf.Views.About.AboutFeaturesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.About"
             xmlns:bootstrap="clr-namespace:SpaceSnoop.Wpf.Bootstrap"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/About/AboutResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Margin="0,0,0,10">
        <StackPanel>
            <TextBlock Text="Что умеет шнырь"
                       Style="{StaticResource About.SectionTitle}" />

            <Grid Margin="0,14,-10,-10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource About.FeatureCard}"
                        Command="{Binding OpenSectionCommand}"
                        CommandParameter="{x:Static bootstrap:SectionKey.Scan}"
                        AutomationProperties.Name="Сканирование">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.HardDrive}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="Сканирование"
                                       Style="{StaticResource About.SectionTitle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Grid.Column="2"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.ChevronRight}"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                        </Grid>
                        <TextBlock
                            Text="Дерево занятого места с тепловой подсветкой долей и карта-treemap плитками по площади. Диск целиком читается по таблице NTFS без двойного счёта жёстких ссылок, а помеченный хлам отправляется в корзину."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource About.FeatureCard}"
                        Command="{Binding OpenSectionCommand}"
                        CommandParameter="{x:Static bootstrap:SectionKey.Sync}"
                        AutomationProperties.Name="Синхронизация">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRightLeft}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="Синхронизация"
                                       Style="{StaticResource About.SectionTitle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Grid.Column="2"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.ChevronRight}"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                        </Grid>
                        <TextBlock
                            Text="Сводит две папки лицом к лицу: цветом видно расхождения, изменённые файлы сверяются по хешу и содержимому строка к строке, а для папок под Git показываются ветки и статус."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource About.FeatureCard}"
                        Command="{Binding OpenSectionCommand}"
                        CommandParameter="{x:Static bootstrap:SectionKey.Overview}"
                        AutomationProperties.Name="Расписание и все профили">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.CalendarClock}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="Расписание и все профили"
                                       Style="{StaticResource About.SectionTitle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Grid.Column="2"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.ChevronRight}"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                        </Grid>
                        <TextBlock
                            Text="На странице «Все профили» пары папок собраны в общую сводку для пакетного сравнения и прогона, а в «Расписании» синхронизация ставится в Планировщик заданий Windows."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource About.FeatureCard}"
                        Command="{Binding OpenSectionCommand}"
                        CommandParameter="{x:Static bootstrap:SectionKey.Cleanup}"
                        AutomationProperties.Name="Очистка и разработка">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="Очистка и разработка"
                                       Style="{StaticResource About.SectionTitle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Grid.Column="2"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.ChevronRight}"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                        </Grid>
                        <TextBlock
                            Text="Системные кэши Windows, ресурсы Docker и раздел «Разработка»: кэши NuGet, артефакты проектов bin/obj/TestResults (в корзину с данными для восстановления), workloads .NET и доверенный dotnet clean."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource About.FeatureCard}"
                        Command="{Binding OpenSectionCommand}"
                        CommandParameter="{x:Static bootstrap:SectionKey.Scan}"
                        AutomationProperties.Name="Архив и дубликаты">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.FileArchive}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="Архив и дубликаты"
                                       Style="{StaticResource About.SectionTitle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Grid.Column="2"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.ChevronRight}"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                        </Grid>
                        <TextBlock
                            Text="Упаковка папок в .zip сверяет архив с содержимым перед отправкой оригинала в корзину. Поиск дубликатов находит одинаковые файлы в отсканированном дереве (включается в настройках сканирования)."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource About.FeatureCard}"
                        Command="{Binding OpenSectionCommand}"
                        CommandParameter="{x:Static bootstrap:SectionKey.Chat}"
                        AutomationProperties.Name="Чат и MCP">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.MessageCircle}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="Чат и MCP"
                                       Style="{StaticResource About.SectionTitle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Grid.Column="2"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.ChevronRight}"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                        </Grid>
                        <TextBlock
                            Text="Встроенный помощник поверх локального CLI (Claude, Codex, OpenCode) отвечает по живому дереву сканирования и плану синхронизации, а встроенный MCP-сервер открывает те же инструменты внешним агентам."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource About.FeatureCard}"
                        Command="{Binding OpenSectionCommand}"
                        CommandParameter="{x:Static bootstrap:SectionKey.Performance}"
                        AutomationProperties.Name="Диагностика">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.Gauge}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="Диагностика"
                                       Style="{StaticResource About.SectionTitle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Grid.Column="2"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.ChevronRight}"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                        </Grid>
                        <TextBlock
                            Text="Отклик интерфейса, расход памяти, сборки мусора, текущие операции и выгрузка обезличенного диагностического пакета одним архивом."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource About.FeatureCard}"
                        Command="{Binding OpenSectionCommand}"
                        CommandParameter="{x:Static bootstrap:SectionKey.Logs}"
                        AutomationProperties.Name="Логи">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.ScrollText}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="Логи"
                                       Style="{StaticResource About.SectionTitle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Grid.Column="2"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.ChevronRight}"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                        </Grid>
                        <TextBlock
                            Text="Живой поток событий сеанса с фильтрами по уровню, источнику и тексту, копированием строк и быстрой сборкой отчёта об ошибке."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
