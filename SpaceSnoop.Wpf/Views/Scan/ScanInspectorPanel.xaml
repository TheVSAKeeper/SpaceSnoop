<UserControl x:Class="SpaceSnoop.Wpf.Views.Scan.ScanInspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Scan"
             xmlns:scan="clr-namespace:SpaceSnoop.Wpf.Views.Scan"
             xmlns:views="clr-namespace:SpaceSnoop.Wpf.Views"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanInspectorViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="380">

    <Border Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}">
        <Grid>
            <scan:ScanInspectorRail
                Visibility="{Binding IsInspectorCollapsed, Converter={StaticResource BoolToVisibility}}" />

            <Grid Visibility="{Binding IsInspectorCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Height="{DynamicResource Control.Height.Default}"
                      Margin="14,12,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Детали"
                               Style="{StaticResource SectionTitle}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding ToggleInspectorCollapsedCommand}"
                            Padding="6"
                            MinHeight="0"
                            VerticalAlignment="Center"
                            ToolTip="Свернуть панель деталей"
                            AutomationProperties.Name="Свернуть панель деталей">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.PanelRightClose}"
                                                  Width="16"
                                                  Height="16" />
                    </Button>
                </Grid>

                <Border Grid.Row="0"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="{DynamicResource Border.Subtle}" />

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="24,12"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel.Resources>
                        <Style x:Key="Inspector.EmptyExtra"
                               TargetType="FrameworkElement">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                                    Value="True">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.MousePointerClick}"
                                              Width="34"
                                              Height="34"
                                              Margin="0,0,0,12"
                                              HorizontalAlignment="Center"
                                              Foreground="{DynamicResource Fg.Muted}"
                                              Opacity="0.7"
                                              Style="{StaticResource Inspector.EmptyExtra}" />
                    <TextBlock Text="Ничего не выбрано"
                               Style="{StaticResource TextBlock.Heading}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="300" />
                    <TextBlock Text="Кликните узел дерева – здесь появятся путь, размеры, доли и крупнейшие вложения."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="240"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource TextBlock.Subtle}">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                                        Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Padding="14,8,14,14"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <scan:ScanInspectorDetails />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
