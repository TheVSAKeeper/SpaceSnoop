<UserControl x:Class="SpaceSnoop.Wpf.Views.Scan.ScanTargetPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Scan"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanViewModel}"
             d:DesignWidth="720"
             IsVisibleChanged="OnIsVisibleChanged"
             MouseDoubleClick="OnTargetDoubleClick"
             PreviewKeyDown="OnTargetKeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Scan/ScanTargetTiles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <CollectionViewSource x:Key="VolumeSource"
                                  Source="{Binding Drives.Volumes}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="PickerBody">
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Что сканируем"
                       Style="{StaticResource SectionTitle}"
                       Foreground="{DynamicResource Fg.Secondary}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding ClosePickerCommand}"
                        Margin="0,0,6,0"
                        ToolTip="Вернуться к результатам сканирования"
                        AutomationProperties.Name="Вернуться к результатам сканирования"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowLeft}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="К результатам"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Icon}"
                        Command="{Binding RefreshDrivesCommand}"
                        ToolTip="Обновить список дисков"
                        AutomationProperties.Name="Обновить список дисков">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                              Width="15"
                                              Height="15" />
                </Button>
            </StackPanel>
        </Grid>

        <ItemsControl x:Name="Targets"
                      Focusable="False"
                      Margin="0,0,-12,0"
                      AutomationProperties.Name="Диски">
            <ItemsControl.ItemsSource>
                <CompositeCollection>
                    <CollectionContainer Collection="{Binding Source={StaticResource VolumeSource}}" />
                    <Button Style="{StaticResource TargetTile.Browse}"
                            Command="{Binding BrowseCommand}"
                            ToolTip="Выбрать другой каталог для анализа"
                            AutomationProperties.Name="Другой каталог" />
                </CompositeCollection>
            </ItemsControl.ItemsSource>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Button Style="{StaticResource Button.Primary}"
                Command="{Binding StartCommand}"
                HorizontalAlignment="Left"
                MinHeight="40"
                Margin="0,4,0,0"
                ToolTip="Посчитать занятое место в выбранной цели. Двойной щелчок или Enter на плитке – то же самое"
                AutomationProperties.Name="{Binding StartCaption}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Play}"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                <TextBlock Text="{Binding StartCaption}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <StackPanel Margin="0,24,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Drives.RecentDirectories.Count}"
                                     Value="0">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="Недавние"
                       Style="{StaticResource Caption}"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Drives.RecentDirectories}"
                          ItemTemplate="{StaticResource TargetTile.Recent}"
                          Focusable="False"
                          AutomationProperties.Name="Недавние каталоги">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
