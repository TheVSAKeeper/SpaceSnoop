<UserControl x:Class="SpaceSnoop.Wpf.Views.Scan.ScanTargetPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Scan"
             xmlns:local="clr-namespace:SpaceSnoop.Wpf.Views.Scan"
             xmlns:conv="clr-namespace:SpaceSnoop.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanViewModel}"
             d:DesignWidth="720"
             IsVisibleChanged="OnIsVisibleChanged"
             MouseDoubleClick="OnTargetDoubleClick"
             PreviewKeyDown="OnTargetKeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Scan/ScanTargetTiles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <CollectionViewSource x:Key="VolumeSource"
                                  Source="{Binding Drives.Volumes}" />

            <conv:IsLessThanConverter x:Key="IsLessThan" />

            <Style x:Key="Button.DestructiveOutline"
                   TargetType="Button"
                   BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource State.Error}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource State.ErrorText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.M}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="{DynamicResource State.ErrorSoft}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused"
                                         Value="True">
                                    <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="{DynamicResource State.ErrorSoft}" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="{DynamicResource State.ErrorSoft}" />
                                    <Setter TargetName="Bd"
                                            Property="BorderBrush"
                                            Value="{DynamicResource State.ErrorPress}" />
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter TargetName="Bd"
                                            Property="Opacity"
                                            Value="0.45" />
                                    <Setter Property="Cursor"
                                            Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="PickerScroll"
                      Grid.Row="0"
                      Focusable="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PickerBody"
                        HorizontalAlignment="Center"
                        MaxWidth="1316">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin"
                                Value="24,96,24,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FirstRun.IsVisible}"
                                         Value="True">
                                <Setter Property="Margin"
                                        Value="24,24,24,0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=local:ScanTargetPicker}, Converter={StaticResource IsLessThan}, ConverterParameter=640}"
                                         Value="True">
                                <Setter Property="Margin"
                                        Value="24,24,24,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <FrameworkElement Width="{Binding ActualWidth, ElementName=PickerActionsRow}"
                                  HorizontalAlignment="Left"
                                  Height="0" />

                <local:FirstRunCard DataContext="{Binding FirstRun}"
                                    MaxWidth="652"
                                    HorizontalAlignment="Left" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Что сканируем"
                               Style="{StaticResource SectionTitle}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding ClosePickerCommand}"
                                Margin="0,0,6,0"
                                ToolTip="Вернуться к результатам сканирования"
                                AutomationProperties.Name="Вернуться к результатам сканирования"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowLeft}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="К результатам"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Icon}"
                                Command="{Binding RefreshDrivesCommand}"
                                ToolTip="Обновить список дисков"
                                AutomationProperties.Name="Обновить список дисков">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                                      Width="15"
                                                      Height="15" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="Targets"
                              Focusable="False"
                              Margin="0,0,-12,0"
                              AutomationProperties.Name="Диски">
                    <ItemsControl.ItemsSource>
                        <CompositeCollection>
                            <CollectionContainer Collection="{Binding Source={StaticResource VolumeSource}}" />
                            <Button Style="{StaticResource TargetTile.Browse}"
                                    Command="{Binding BrowseCommand}"
                                    ToolTip="Выбрать другой каталог для анализа"
                                    AutomationProperties.Name="Другой каталог" />
                        </CompositeCollection>
                    </ItemsControl.ItemsSource>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Margin="0,12,0,12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Drives.RecentDirectories.Count}"
                                             Value="0">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Недавние"
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Drives.RecentDirectories}"
                                  ItemTemplate="{StaticResource TargetTile.Recent}"
                                  Focusable="False"
                                  AutomationProperties.Name="Недавние каталоги">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="PickerActions"
                Grid.Row="1"
                HorizontalAlignment="Left"
                Width="{Binding ViewportWidth, ElementName=PickerScroll}"
                Padding="0,12,0,12"
                BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=PickerScroll}"
                                     Value="{x:Static Visibility.Visible}">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource Border.Subtle}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid HorizontalAlignment="Center"
                  Width="{Binding ActualWidth, ElementName=PickerBody}">
                <StackPanel x:Name="PickerActionsRow"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button x:Name="StartButton"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding StartCommand}"
                            MinHeight="40"
                            ToolTip="Посчитать занятое место в выбранной цели. Двойной щелчок или Enter на плитке – то же самое"
                            AutomationProperties.Name="{Binding StartCaption}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Play}"
                                                      Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StartCaption}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Button.DestructiveOutline}"
                            Command="{Binding Marks.DeleteMarkedCommand}"
                            Margin="12,0,0,0"
                            ToolTip="{Binding Marks.DeleteHint}"
                            AutomationProperties.Name="{Binding Marks.MarkedCount, StringFormat='Удалить помеченное: {0}'}"
                            Visibility="{Binding Marks.HasMarked, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                      Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Marks.MarkedCount, StringFormat='Удалить ({0:N0})'}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
