<UserControl x:Class="SpaceSnoop.Wpf.Views.Scan.ScanStructurePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Scan"
             xmlns:controls="clr-namespace:SpaceSnoop.Wpf.Views.Scan"
             xmlns:views="clr-namespace:SpaceSnoop.Wpf.Views"
             xmlns:bootstrap="clr-namespace:SpaceSnoop.Wpf.Bootstrap"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanViewModel}"
             d:DesignHeight="480"
             d:DesignWidth="560">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Scan/ScanNodeContextMenu.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Scan/ScanTreeRowTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Scan/ScanTreemapTooltip.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ToggleButton.Header"
                   TargetType="ToggleButton"
                   BasedOn="{StaticResource ToggleButton.Toolbar}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                                 Value="True">
                        <Setter Property="Height"
                                Value="{DynamicResource Control.Height.Compact}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TreeRow"
                               Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  x:Name="HeaderBar">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin"
                                Value="10,4,12,6" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                                         Value="True">
                                <Setter Property="Margin"
                                        Value="10,0,12,2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <WrapPanel Orientation="Horizontal">
                    <Border MinHeight="{DynamicResource Control.Height.Default}"
                            Margin="0,2,16,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                                                       Value="True" />
                                            <Condition Binding="{Binding HasResult}"
                                                       Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Структура каталога"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,2,12,2"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <ListBox Style="{StaticResource ListBox.SegmentedCompact}"
                                 ItemsSource="{Binding ViewModes}"
                                 SelectedIndex="{Binding SelectedViewIndex}"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="Вид структуры" />

                        <ToggleButton x:Name="HeatToggle"
                                      Style="{StaticResource ToggleButton.Header}"
                                      Margin="6,0,0,0"
                                      MinWidth="34"
                                      Padding="0"
                                      ToolTip="Чувствительность тепловой подсветки"
                                      AutomationProperties.Name="Тепловая подсветка">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Flame}"
                                                      Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center" />
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,2,0,2"
                                Visibility="{Binding TreeVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <ComboBox ItemsSource="{Binding Sort.Options}"
                                  SelectedItem="{Binding Sort.SelectedOption}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,6,0"
                                  ToolTip="Поле сортировки строк дерева">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox"
                                       BasedOn="{StaticResource ComboBox.Toolbar}">
                                    <Setter Property="MinWidth"
                                            Value="132" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                                                     Value="True">
                                            <Setter Property="MinWidth"
                                                    Value="0" />
                                            <Setter Property="Height"
                                                    Value="{DynamicResource Control.Height.Compact}" />
                                            <Setter Property="MinHeight"
                                                    Value="{DynamicResource Control.Height.Compact}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <ToggleButton Style="{StaticResource ToggleButton.Header}"
                                      IsChecked="{Binding Sort.Invert}"
                                      MinWidth="34"
                                      Padding="0"
                                      ToolTip="Направление: отмечено – по убыванию, снято – по возрастанию"
                                      AutomationProperties.Name="Направление сортировки">
                            <iconPacks:PackIconLucide Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center">
                                <iconPacks:PackIconLucide.Style>
                                    <Style TargetType="iconPacks:PackIconLucide">
                                        <Setter Property="Kind"
                                                Value="ArrowUpNarrowWide" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sort.Invert}"
                                                         Value="True">
                                                <Setter Property="Kind"
                                                        Value="ArrowDownWideNarrow" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconLucide.Style>
                            </iconPacks:PackIconLucide>
                        </ToggleButton>
                    </StackPanel>
                </WrapPanel>

                <Popup x:Name="HeatPopup"
                       PlacementTarget="{Binding ElementName=HeatToggle}"
                       Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=HeatToggle, Mode=TwoWay}"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       VerticalOffset="6">
                    <Border Background="{DynamicResource Bg.Surface}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="12"
                            MinWidth="260">
                        <StackPanel>
                            <TextBlock Text="Тепловая подсветка"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       Margin="0,0,0,8" />

                            <Border Height="8"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Background="{StaticResource HeatSpectrum}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="мягче"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />

                                <Slider x:Name="HeatSlider"
                                        Grid.Column="1"
                                        Minimum="{x:Static bootstrap:AppDefaults.IntensityMin}"
                                        Maximum="{x:Static bootstrap:AppDefaults.IntensityMax}"
                                        Value="{Binding Intensity}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Margin="9,0,9,0"
                                        AutomationProperties.Name="Чувствительность тепловой подсветки" />

                                <TextBlock Grid.Column="2"
                                           Text="резче"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Intensity, StringFormat=0}"
                                           FontSize="{DynamicResource Font.Size.M}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Accent.Text}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           MinWidth="18"
                                           TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Border Grid.Row="0"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{DynamicResource Border.Subtle}" />

            <TreeView Grid.Row="1"
                      x:Name="Tree"
                      AutomationProperties.Name="Структура каталога"
                      ItemsSource="{Binding Roots}"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="0,4,0,0"
                      Foreground="{DynamicResource Fg.Primary}"
                      PreviewMouseRightButtonDown="OnTreeRightButtonDown"
                      SelectedItemChanged="OnTreeSelectedItemChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ItemTemplate="{StaticResource ScanTreeRow}"
                      Visibility="{Binding TreeVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem"
                           BasedOn="{StaticResource TreeViewItem.Default}">
                        <Setter Property="IsExpanded"
                                Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Padding"
                                Value="2,2" />
                        <Setter Property="ContextMenu"
                                Value="{StaticResource ScanNodeMenu}" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <Grid Grid.Row="1"
                  Margin="0,4,0,0"
                  DataContext="{Binding Treemap}"
                  Visibility="{Binding DataContext.TreemapVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="10,2,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding TreemapBreadcrumbs}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide
                                        Kind="{x:Static iconPacks:PackIconLucideKind.ChevronRight}"
                                        Width="13"
                                        Height="13"
                                        VerticalAlignment="Center"
                                        Margin="1,0,1,0"
                                        Foreground="{DynamicResource Fg.Muted}"
                                        Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource Button.Ghost}"
                                            MinHeight="0"
                                            Padding="6,3"
                                            Content="{Binding Node.Name}"
                                            ToolTip="{Binding Node.AbsolutePath}"
                                            Command="{Binding DataContext.DrillToCrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Node}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TreemapTruncatedText}"
                               Style="{StaticResource Caption}"
                               Visibility="{Binding TreemapTruncated, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource Bg.SurfaceMute}"
                        CornerRadius="{DynamicResource Radius.S}"
                        ClipToBounds="True">
                    <Grid>
                        <controls:TreemapView x:Name="Treemap"
                                              ItemsSource="{Binding TreemapTiles}"
                                              Intensity="{Binding DataContext.Intensity, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding DataContext.SelectedNode, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              DrillCommand="{Binding DrillIntoCommand}"
                                              NodeContextMenu="{StaticResource ScanNodeMenu}"
                                              NodeTooltipTemplate="{StaticResource TreemapTooltip}"
                                              TooltipStyle="{StaticResource TreemapTooltipBeak}"
                                              Visibility="{Binding HasTreemapTiles, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasTreemapTiles, Converter={StaticResource InverseBoolToVisibility}}">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                      Width="34"
                                                      Height="34"
                                                      HorizontalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Muted}"
                                                      Opacity="0.7" />
                            <TextBlock Text="Здесь пусто"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <controls:ScanDuplicatesPanel x:Name="Duplicates"
                                          Grid.Row="1"
                                          Margin="0,4,0,0"
                                          DataContext="{Binding Duplicates}"
                                          Visibility="{Binding DataContext.DuplicatesVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

            <keepshell:EmptyState Grid.Row="1"
                                  Icon="Radar"
                                  IconSize="40"
                                  Heading="Обходим каталоги"
                                  DescriptionMaxWidth="440"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Visibility="{Binding ShowScanningState, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <keepshell:EmptyState.Style>
                    <Style TargetType="keepshell:EmptyState">
                        <Setter Property="Description"
                                Value="{Binding ScanTargetPath, StringFormat='Дерево появится, когда обход {0} закончится – ход виден в панели выше. Прервать можно кнопкой «Остановить» или клавишей Esc.'}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                                         Value="True">
                                <Setter Property="Description"
                                        Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </keepshell:EmptyState.Style>
            </keepshell:EmptyState>

            <Grid x:Name="StaleResultOverlay"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Visibility="{Binding ShowStaleResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Border Background="{DynamicResource Bg.Base}"
                        Opacity="0.6"
                        CornerRadius="{DynamicResource Radius.S}" />

                <Border Style="{StaticResource Card}"
                        Padding="16,12"
                        MaxWidth="480"
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconLucide Grid.Column="0"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.History}"
                                                  Width="16"
                                                  Height="16"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,10,0"
                                                  Foreground="{DynamicResource Fg.Secondary}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StaleResultCaption}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Fg.Primary}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
