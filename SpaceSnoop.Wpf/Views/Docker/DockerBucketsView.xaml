<UserControl x:Class="SpaceSnoop.Wpf.Views.Docker.DockerBucketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Docker"
             xmlns:conv="clr-namespace:SpaceSnoop.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DockerViewModel}"
             Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
    <UserControl.Resources>
        <conv:FractionToWidthConverter x:Key="FractionToWidth" />
        <Style x:Key="Docker.SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontWeight"
                    Value="{DynamicResource Font.Weight.SemiBold}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}"
            Margin="0,0,0,10">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Что занимает место"
                           Style="{StaticResource Docker.SectionTitle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsIdle}"
                        AutomationProperties.Name="Обновить"
                        ToolTip="Опросить Docker заново">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                              Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding Buckets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,8"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Count, StringFormat='Объектов: {0:N0}'}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource TextBlock.Mono}"
                                               TextAlignment="Right" />
                                    <TextBlock Text="{Binding ReclaimText, StringFormat='Можно вернуть: {0}'}"
                                               Style="{StaticResource Caption}" TextAlignment="Right" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border x:Name="BucketTrack"
                                        Grid.Row="1" Grid.ColumnSpan="2"
                                        Height="4"
                                        Margin="0,6,0,0"
                                        Background="{DynamicResource Bg.SurfaceMute}"
                                        CornerRadius="{DynamicResource Radius.S}"
                                        VerticalAlignment="Center"
                                        ToolTip="Длина полосы – доля от самой крупной категории, закрашенная часть – то, что можно вернуть">
                                    <Grid HorizontalAlignment="Left">
                                        <Rectangle HorizontalAlignment="Left"
                                                   Height="4"
                                                   RadiusX="4"
                                                   RadiusY="4"
                                                   Fill="{DynamicResource Border.Strong}">
                                            <Rectangle.Width>
                                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                    <Binding Path="Fraction" />
                                                    <Binding Path="ActualWidth"
                                                             ElementName="BucketTrack" />
                                                </MultiBinding>
                                            </Rectangle.Width>
                                        </Rectangle>
                                        <Rectangle HorizontalAlignment="Left"
                                                   Height="4"
                                                   RadiusX="4"
                                                   RadiusY="4"
                                                   Fill="{DynamicResource Accent.Primary}">
                                            <Rectangle.Width>
                                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                    <Binding Path="ReclaimFraction" />
                                                    <Binding Path="ActualWidth"
                                                             ElementName="BucketTrack" />
                                                </MultiBinding>
                                            </Rectangle.Width>
                                        </Rectangle>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding TotalsText}"
                       Style="{StaticResource TextBlock.Subtle}"
                       Foreground="{DynamicResource Fg.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
