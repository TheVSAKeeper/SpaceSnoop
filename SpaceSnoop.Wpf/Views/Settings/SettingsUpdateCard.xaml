<UserControl x:Class="SpaceSnoop.Wpf.Views.Settings.SettingsUpdateCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Settings"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="900"
             Visibility="{Binding Sections[update].IsSelected, Converter={StaticResource BoolToVisibility}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <HeaderedContentControl Style="{StaticResource Form.Panel}"
                            Header="{Binding Sections[update].Title}"
                            keepshell:Form.ResetCommand="{Binding ResetSectionCommand}"
                            keepshell:Form.ResetCommandParameter="update"
                            keepshell:Form.ResetHint="{Binding ResetPlans[update].Hint}">
        <StackPanel>
            <TextBlock Text="Репозиторий обновлений"
                       Style="{StaticResource Form.Label}" />
            <TextBlock Style="{StaticResource Form.Hint}"
                       Text="Откуда брать релизы, формат owner/repo." />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding Update.Repository, UpdateSourceTrigger=LostFocus}"
                     FontFamily="{DynamicResource Font.Mono}"
                     Margin="0,10,0,0" />

            <ItemsControl ItemsSource="{Binding UpdateRepositoryPresets}"
                          Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="{Binding}"
                                Command="{Binding DataContext.SetUpdateRepositoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Подставить этот репозиторий"
                                Padding="10,4"
                                Margin="0,0,8,8"
                                FontFamily="{DynamicResource Font.Mono}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Проверять обновления при запуске"
                          IsChecked="{Binding Update.CheckOnStartup, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.update.check]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Автоматически скачивать новую версию рядом с программой"
                          IsChecked="{Binding Update.AutoDownload, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.update.auto_download]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Text="Файл не запускается – установка остаётся за вами." />
            <Expander Style="{StaticResource Setting.Details}"
                      Header="Что именно скачивается">
                <TextBlock Style="{StaticResource Setting.DetailsBody}"
                           Text="Скачивается ассет той же редакции, что и запущенная программа (exe или portable), в её папку. Проверка идёт по релизам указанного выше репозитория на GitHub." />
            </Expander>

            <WrapPanel Margin="0,16,0,-8">
                <Button Style="{StaticResource Button.Secondary}"
                        Content="Проверить сейчас"
                        Command="{Binding Updater.CheckNowCommand}"
                        Margin="0,0,10,8" />
                <Button Style="{StaticResource Button.Primary}"
                        Content="{Binding Updater.ActionText}"
                        Command="{Binding Updater.ShowDetailsCommand}"
                        Margin="0,0,12,8"
                        Visibility="{Binding Updater.HasPendingUpdate, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Updater.CheckStatus}"
                           Style="{StaticResource Form.Hint}"
                           Margin="0,0,0,8"
                           VerticalAlignment="Center"
                           Visibility="{Binding Updater.HasCheckStatus, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
