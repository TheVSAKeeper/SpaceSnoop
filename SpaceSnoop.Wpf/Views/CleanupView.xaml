<UserControl x:Class="SpaceSnoop.Wpf.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Cleanup"
             xmlns:cleanup="clr-namespace:SpaceSnoop.Wpf.Views.Cleanup"
             xmlns:views="clr-namespace:SpaceSnoop.Wpf.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CleanupPageViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0"
                 Style="{StaticResource ListBox.Segmented}"
                 ItemsSource="{Binding Sections}"
                 SelectedIndex="{Binding SelectedSectionIndex}"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12"
                 AutomationProperties.Name="Раздел очистки" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding ElapsedText}"
                       Style="{StaticResource Caption}"
                       Margin="0,0,0,6"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl x:Name="Operations"
                          ItemsSource="{Binding Operations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource Card.Inset}"
                                Padding="12,8"
                                Margin="0,0,12,8"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Остановить"
                                        Margin="12,0,0,0"
                                        Style="{DynamicResource Button.Ghost}"
                                        Command="{Binding CancelCommand}">
                                    <Button.Visibility>
                                        <Binding Path="CancelCommand"
                                                 Converter="{StaticResource NullToVisibility}" />
                                    </Button.Visibility>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{Binding PageTitle}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusCaption}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,6" />
                                    <ProgressBar Height="4"
                                                 Minimum="0"
                                                 Maximum="{Binding ProgressMax}"
                                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,12,0"
                          DataContext="{Binding Windows}"
                          Visibility="{Binding DataContext.IsWindowsActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                <StackPanel RequestBringIntoView="SuppressAutoScroll">
                    <Border Style="{StaticResource Card}"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <cleanup:CleanupToolbar />
                            <cleanup:CleanupSummaryStrip />
                        </StackPanel>
                    </Border>
                    <cleanup:CleanupTargetList />
                </StackPanel>
            </ScrollViewer>

            <views:DockerView DataContext="{Binding Docker}"
                              Visibility="{Binding DataContext.IsDockerActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
            <cleanup:DeveloperCleanupView DataContext="{Binding Development}"
                                          Visibility="{Binding DataContext.IsDevelopmentActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
