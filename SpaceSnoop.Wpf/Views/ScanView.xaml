<UserControl x:Class="SpaceSnoop.Wpf.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Scan"
             xmlns:controls="clr-namespace:SpaceSnoop.Wpf.Views.Scan"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="980">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ScanToolbar Grid.Row="0"
                              Visibility="{Binding ShowScanResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}" />

        <controls:ScanProgressPanel Grid.Row="1"
                                    DataContext="{Binding Progress}" />

        <Border Grid.Row="2"
                x:Name="CancelledNotice"
                Style="{StaticResource Card.Inset}"
                Padding="0"
                Margin="0,0,0,12"
                Visibility="{Binding ScanWasCancelled, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource State.Warning}"
                        CornerRadius="10,0,0,10" />

                <Grid Grid.Column="1"
                      Margin="14,10,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconLucide Grid.Column="0"
                                              Kind="{x:Static iconPacks:PackIconLucideKind.OctagonAlert}"
                                              Width="16"
                                              Height="16"
                                              VerticalAlignment="Top"
                                              Margin="0,2,10,0"
                                              Foreground="{DynamicResource State.WarningText}" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding CancelledCaption}"
                                   ToolTip="{Binding CancelledPath}"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                   Foreground="{DynamicResource Fg.Primary}" />
                        <TextBlock
                            Text="Прежний результат этой папки убран в начале скана, чтобы освободить память. Чтобы увидеть её снова, просканируйте папку ещё раз."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,2,0,0"
                            Visibility="{Binding CancelledReleasedPrevious, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding RescanCancelledCommand}"
                                Margin="0,0,6,0"
                                AutomationProperties.Name="Сканировать снова">
                            <Button.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="{Binding CancelledPath, StringFormat='Сканировать {0} заново'}" />
                                </ToolTip>
                            </Button.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RotateCw}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Сканировать снова"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding DismissCancelledCommand}"
                                Content="Скрыть"
                                ToolTip="Убрать это сообщение"
                                AutomationProperties.Name="Скрыть сообщение об остановке" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3"
              Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <controls:ScanSummaryStrip DataContext="{Binding Summary}" />
        </Grid>

        <Grid Grid.Row="4"
              Visibility="{Binding ShowScanResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <controls:ScanTipCard DataContext="{Binding Tips}" />
        </Grid>

        <controls:ScanTargetPicker Grid.Row="5"
                                   Visibility="{Binding ShowTargetPicker, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

        <Grid Grid.Row="5"
              x:Name="ContentArea"
              SizeChanged="OnContentAreaSizeChanged"
              Visibility="{Binding ShowScanResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StructureColumn"
                                  Width="*"
                                  MinWidth="260" />
                <ColumnDefinition x:Name="SplitterColumn"
                                  Width="Auto" />
                <ColumnDefinition x:Name="InspectorColumn"
                                  Width="380"
                                  MinWidth="280" />
            </Grid.ColumnDefinitions>

            <controls:ScanStructurePanel Grid.Column="0"
                                         x:Name="Structure" />

            <GridSplitter Grid.Column="1"
                          x:Name="InspectorSplitter"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="False"
                          AutomationProperties.Name="Ширина панели деталей"
                          DragCompleted="OnInspectorSplitterDragCompleted"
                          ToolTip="Перетащите, чтобы изменить ширину панели"
                          Visibility="{Binding Inspector.IsInspectorCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />

            <controls:ScanInspectorPanel Grid.Column="2"
                                         DataContext="{Binding Inspector}" />
        </Grid>
    </Grid>
</UserControl>
