<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(UseNet11)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(UseNet11)' == 'true'">net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SpaceSnoop.Wpf</RootNamespace>
    <AssemblyName>SpaceSnoop.Wpf</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <DisableMicrosoftExtensionsLoggingSourceGenerator>true</DisableMicrosoftExtensionsLoggingSourceGenerator>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <KeepShellBuildStamp>true</KeepShellBuildStamp>
    <PortableBuild Condition="'$(PortableBuild)' == ''">false</PortableBuild>
    <!-- Self-contained single-file WPF requires IncludeAllContentForSelfExtract for C++/CLI DirectWriteForwarder.dll -->
    <NoWarn>$(NoWarn);NETSDK1244</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PortableBuild</_Parameter1>
      <_Parameter2>$(PortableBuild)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <InternalsVisibleTo Include="SpaceSnoop.Wpf.Tests" />
    <InternalsVisibleTo Include="SpaceSnoop.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpaceSnoop.Core\SpaceSnoop.Core.csproj" />
    <PackageReference Include="KeepShell" Version="0.1.272" />
    <PackageReference Include="KeepShell.Agents" Version="0.1.272" />
    <PackageReference Include="KeepShell.Automation" Version="0.1.272" />
    <PackageReference Include="KeepShell.Themes.Tarkov" Version="0.1.272" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Tomlyn" Version="2.11.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNet11)' != 'true'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNet11)' == 'true'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

</Project>
